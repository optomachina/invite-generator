OPENAI_API_KEY=sk-...

# --- App ---
# Absolute base URL for magic links emailed out by the webhook (no trailing slash).
# Local dev: http://localhost:3001    Vercel preview: https://<branch>-<proj>.vercel.app    Prod: https://<your-domain>
APP_URL=http://localhost:3001

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local dev: copy whsec_… from `stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe`
# Production: read it from the webhook endpoint's "Signing secret" in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
# A Price object for the $10 invite — see README for one-line creation
STRIPE_PRICE_ID=price_...

# --- Resend (email delivery) ---
RESEND_API_KEY=re_...
# Verified sending domain. While unverified, use onboarding@resend.dev for testing.
RESEND_FROM=invites@yourdomain.tld

# --- Postgres (Neon) ---
# Pooled URL with ?sslmode=require — copy from Neon dashboard → connection details
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
